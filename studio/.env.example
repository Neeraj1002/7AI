# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Database ---
DATABASE_URL="postgresql://sevenai_app:CHANGE_ME@127.0.0.1:5432/sevenai_dev"

# --- LLM (used by Intake parsing, studio/src/run-pipeline/parse-brief.ts) ---
ANTHROPIC_API_KEY=""

# --- Telegram bot (Task 6) ---
# Create via @BotFather in Telegram, then message the bot once so it shows up in getUpdates.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_FOUNDER_CHAT_ID=""

# --- YouTube API / OAuth (Task 7) ---
# Stopgap per SCHEMA.md Section 2 — moves to the AgentCredential table once channel #2 exists.
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI="http://localhost:3000/oauth2callback"
YOUTUBE_REFRESH_TOKEN=""

# --- Media generation: TTS + transcription (Week 3 Task 1, studio/src/media/) ---
OPENAI_API_KEY=""

# --- Stock footage (Week 4 Task 1, studio/src/stock-footage/) ---
# pexels.com/api — free, commercial-use license, no attribution required.
PEXELS_API_KEY=""
# Testing-only: '1' uses a local generated placeholder clip instead of a real
# Pexels call, same convention as MEDIA_STUB.
STOCK_FOOTAGE_STUB=""

# --- FFmpeg (Week 3 Task 2+) ---
# Absolute paths if not on PATH (e.g. right after a winget/package-manager
# install, before a shell restart) -- otherwise leave as plain 'ffmpeg'/'ffprobe'.
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"

# --- Misc ---
NODE_ENV="development"

# Sprint 3 Task 10 (R1) — which file actually gets loaded depends on NODE_ENV
# (studio/src/config/env.ts): NODE_ENV=production reads `.env`; anything else
# (unset, 'development', ...) reads `.env.local`, unchanged from before this
# task. In practice: local dev copies this to `.env.local`; a real server
# (the preview VPS, or any other NODE_ENV=production deployment) copies this
# to `.env` instead. Never commit either — both are gitignored.

# --- Database ---
DATABASE_URL="postgresql://sevenai_app:CHANGE_ME@127.0.0.1:5432/sevenai_dev"

# --- LLM (used by Intake parsing, studio/src/run-pipeline/parse-brief.ts) ---
ANTHROPIC_API_KEY=""

# --- YouTube API / OAuth (Task 7) ---
# Stopgap per SCHEMA.md Section 2 — moves to the AgentCredential table once channel #2 exists.
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
# MUST be localhost or a real public HTTPS domain (e.g. an ngrok tunnel) and
# registered as an authorized redirect URI on the OAuth client in Google Cloud
# Console. NEVER a LAN IP (192.168.x.x etc.) — Google rejects it with "device_id
# and device_name are required for private IP" (Bugs Task 5). Unrelated to
# PUBLIC_API_BASE_URL below, which is for phone-opened links and may be a LAN IP.
# The /oauth2callback route lives on API_PORT.
# For phone-based testing, use a Tailscale Funnel HTTPS URL instead of localhost — see task5.md R2.
YOUTUBE_REDIRECT_URI="http://localhost:4000/oauth2callback"
YOUTUBE_REFRESH_TOKEN=""
# Testing-only: '1' uses a stub upload/stats path instead of real YouTube Data
# API v3 calls (both Publishing's upload and Performance Analytics' polling),
# same convention as MEDIA_STUB. Set until YOUTUBE_REFRESH_TOKEN above is real.
YOUTUBE_STUB=""

# --- Media generation: TTS + transcription (Week 3 Task 1, studio/src/media/) ---
OPENAI_API_KEY=""

# --- Stock footage (Week 4 Task 1, studio/src/stock-footage/) ---
# pexels.com/api — free, commercial-use license, no attribution required.
PEXELS_API_KEY=""
# Testing-only: '1' uses a local generated placeholder clip instead of a real
# Pexels call, same convention as MEDIA_STUB.
STOCK_FOOTAGE_STUB=""

# --- FFmpeg (Week 3 Task 2+) ---
# Absolute paths if not on PATH (e.g. right after a winget/package-manager
# install, before a shell restart) -- otherwise leave as plain 'ffmpeg'/'ffprobe'.
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"

# --- API auth (Sprint 3 Task 1) ---
API_AUTH_TOKEN=""
API_PORT="4000"
# Signs magic-link and session JWTs. No insecure default — generate a real
# random value (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
# and keep it stable across restarts, or every existing session is silently
# invalidated. Without this set, /auth/request-link and /auth/verify return
# a clear 503; the API server itself still starts fine on API_AUTH_TOKEN alone.
JWT_SECRET=""
# The origin used to build the clickable /auth/verify link in the
# magic-link console output (and any Telegram message — see
# TELEGRAM_BOT_TOKEN below). Defaults to http://localhost:<API_PORT> when
# unset, which is meaningless on a phone (Bugs Task 4/R3) — set this to
# the dev machine's real LAN IP, e.g. "http://192.168.1.23:4000".
PUBLIC_API_BASE_URL=""
# --- Per-channel OAuth credential encryption (Sprint 3 Task 5) ---
# 32 raw bytes, base64-encoded, AES-256-GCM key encrypting every
# AgentCredential.refreshTokenEncrypted at rest. No insecure default.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=""

# --- Push notifications (Sprint 3 Task 7) ---
# Optional. Expo's push API works without an access token; set one only if
# you've configured enhanced push-security for this project's Expo account.
EXPO_ACCESS_TOKEN=""

# --- Magic-link delivery via Telegram (Bugs Task 3/R5) ---
# Optional — create via Telegram's @BotFather. Unset means console-only
# magic-link delivery, same as before this feature existed.
TELEGRAM_BOT_TOKEN=""

# --- Generated media storage: Cloudflare R2 (Sprint 3 Task 12) ---
# Optional — a checkout without these just skips R2 upload entirely (best
# -effort everywhere it's called), same as this project's other optional
# integrations. R2 is S3-API-compatible: R2_ENDPOINT is the account's R2
# endpoint, not an AWS one. One shared bucket for both local and preview;
# object keys are namespaced by NODE_ENV so they never collide.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_ENDPOINT=""
R2_REGION=""

# --- Misc ---
NODE_ENV="development"

# --- Added by Bugs Task 12 (R10.1): every variable env.ts reads that was missing above ---
# Stub flags ("1" = placeholder output instead of a real provider call; leave empty on preview/production).
INTAKE_STAGE_STUB=""
MEDIA_STUB=""
AI_VISUALS_STUB=""
YOUTUBE_ANALYTICS_STUB=""
# Background timers and windows (milliseconds unless noted; defaults shown).
ANALYTICS_POLL_INTERVAL_MS="21600000"
FOUNDER_DIGEST_CHECK_INTERVAL_MS="1800000"
FOUNDER_DIGEST_INTERVAL_MS="86400000"
GATE_REMINDER_CHECK_INTERVAL_MS="900000"
GATE_REMINDER_THRESHOLD_MS="14400000"
RESUME_STALE_WINDOW_MS="1800000"
TELEGRAM_START_POLL_INTERVAL_MS="3000"
# A re-sent gate prompt (after a restart) pushes at most once per window; gates older than N days reopen silently.
GATE_RESEND_PUSH_WINDOW_MS="1800000"
GATE_RESEND_STALE_DAYS="14"
# Test-only: delay before the publishing-kill test hook fires. Leave 0.
PUBLISHING_TEST_KILL_DELAY_MS="0"
# Comma-separated browser origins allowed by CORS (the native app sends no Origin). PUBLIC_API_BASE_URL's origin is always allowed.
CORS_ALLOWED_ORIGINS=""
# NOTE: R2_TOKEN_VALUE may exist in a server .env but no code reads it; only the S3-style R2_* set above is used.

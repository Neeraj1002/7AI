# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Database ---
DATABASE_URL="postgresql://sevenai_app:CHANGE_ME@127.0.0.1:5432/sevenai_dev"

# --- LLM (used by Intake parsing, studio/src/run-pipeline/parse-brief.ts) ---
ANTHROPIC_API_KEY=""

# --- YouTube API / OAuth (Task 7) ---
# Stopgap per SCHEMA.md Section 2 — moves to the AgentCredential table once channel #2 exists.
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI="http://localhost:3000/oauth2callback"
YOUTUBE_REFRESH_TOKEN=""
# Testing-only: '1' uses a stub upload/stats path instead of real YouTube Data
# API v3 calls (both Publishing's upload and Performance Analytics' polling),
# same convention as MEDIA_STUB. Set until YOUTUBE_REFRESH_TOKEN above is real.
YOUTUBE_STUB=""

# --- Media generation: TTS + transcription (Week 3 Task 1, studio/src/media/) ---
OPENAI_API_KEY=""

# --- Stock footage (Week 4 Task 1, studio/src/stock-footage/) ---
# pexels.com/api — free, commercial-use license, no attribution required.
PEXELS_API_KEY=""
# Testing-only: '1' uses a local generated placeholder clip instead of a real
# Pexels call, same convention as MEDIA_STUB.
STOCK_FOOTAGE_STUB=""

# --- FFmpeg (Week 3 Task 2+) ---
# Absolute paths if not on PATH (e.g. right after a winget/package-manager
# install, before a shell restart) -- otherwise leave as plain 'ffmpeg'/'ffprobe'.
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"

# --- API auth (Sprint 3 Task 1) ---
API_AUTH_TOKEN=""
API_PORT="4000"
# Signs magic-link and session JWTs. No insecure default — generate a real
# random value (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
# and keep it stable across restarts, or every existing session is silently
# invalidated. Without this set, /auth/request-link and /auth/verify return
# a clear 503; the API server itself still starts fine on API_AUTH_TOKEN alone.
JWT_SECRET=""
# --- Per-channel OAuth credential encryption (Sprint 3 Task 5) ---
# 32 raw bytes, base64-encoded, AES-256-GCM key encrypting every
# AgentCredential.refreshTokenEncrypted at rest. No insecure default.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=""

# --- Push notifications (Sprint 3 Task 7) ---
# Optional. Expo's push API works without an access token; set one only if
# you've configured enhanced push-security for this project's Expo account.
EXPO_ACCESS_TOKEN=""

# --- Misc ---
NODE_ENV="development"

// 7AI — Week 1 Foundation Schema
// Source of truth for field-level shape: docs/execution/week1/SCHEMA.md
// Enum strategy: VARCHAR + CHECK constraint, not native Postgres ENUM — see SCHEMA.md
// "Enum Strategy" section. Prisma enums are deliberately NOT used here because they
// compile to native Postgres ENUM types.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  // Sprint 2 Task 6 (I1) — nullable, null for every existing tenant (no
  // digest ever sent yet). Persisted rather than relying on process uptime
  // alone: this dev process has restarted far more often than once a day
  // throughout this project, so a plain setInterval(fn, 24h) would likely
  // never actually fire in practice. See run-pipeline/founder-digest.ts.
  lastFounderDigestSentAt DateTime?

  channels             Channel[]
  pipelineRuns         PipelineRun[]
  reviewLogs           ReviewLog[]
  agentQuotas          AgentQuota[]
  usageEvents          UsageEvent[]
  performanceSnapshots PerformanceSnapshot[]
  // Sprint 3 Task 1 (J1) — a User belongs to exactly one Tenant, not a
  // many-to-many join: MVP_PART2 §0 frames each of the ~10 testers as
  // bringing their own account, not joining someone else's. See
  // sprint3/BUSINESS_LOGIC.md for the full rationale.
  users                User[]
  notifications        Notification[]

  @@map("tenants")
}

// Sprint 3 Task 1 (J1) — the real user model MVP_PART2 §1 flagged as the
// biggest open gap. Two roles only, not a full RBAC system: 'owner'
// (everything — approve gates, manage channels/credentials, invite) and
// 'approver' (view + approve gates, nothing else) — matches the design
// doc's own gate-ownership note ("probably just 'the channel's owner' to
// start"), extendable later if a real need for more roles shows up. VARCHAR
// + CHECK, not a native enum, same convention this schema uses everywhere
// (see this file's own header comment).
model User {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String  @db.Uuid
  email    String  @unique @db.VarChar(255)
  name     String? @db.VarChar(255)
  role     String  @default("owner") @db.VarChar(20)

  // Sprint 3 Task 7 (O1) — set via a real device registering its Expo push
  // token (notifications.registerPushToken), once per device. Replaces
  // Task 3 (K2)'s original chat-linking equivalent (retired by this same
  // task's O2, which removed that whole notification channel — it was only
  // ever a testing convenience, not meant to be permanent). null means
  // "in-app notifications only" — a fully valid, handled state, not a
  // degraded one.
  expoPushToken String? @db.VarChar(255)

  // Bugs Task 3 (R5) — re-added: a column of this exact name/type existed
  // from Sprint 3 Task 1 (J1) through Task 7 (O2), which dropped it when the
  // old founder-only Telegram relay was retired entirely (not just left
  // unused, as this task's own doc first assumed — confirmed by direct read
  // of migration 20260920075853_sprint3_retire_telegram_add_push, which
  // includes `DROP COLUMN "telegramChatId"`). This task rebuilds Telegram
  // delivery narrowly for the magic-link flow only, so the column is
  // reintroduced fresh here rather than "restored," even though the shape
  // is identical to before.
  telegramChatId String? @db.VarChar(50)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  loginTokens   LoginToken[]
  // Sprint 3 Task 2 (K1) — reverse side of Channel.ownerUserId.
  ownedChannels Channel[]
  // Sprint 4 Task 1: reverse side of ChannelProfileVersion.createdByUserId.
  createdProfileVersions ChannelProfileVersion[]
  notifications Notification[]

  @@index([tenantId], map: "idx_users_tenant")
  @@map("users")
}

// Sprint 3 Task 1 (J2) — one row per issued magic-link token. The JWT
// signature alone only proves authenticity, not first-use; usedAt (checked
// and set at /auth/verify) is what actually prevents replay of a link that
// leaked (e.g. forwarded email, a shoulder-surfed screen).
model LoginToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  jti       String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId], map: "idx_login_tokens_user")
  @@map("login_tokens")
}

model Channel {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String  @db.Uuid
  platform          String  @default("youtube") @db.VarChar(20)
  name              String  @db.VarChar(255)
  externalChannelId String? @db.VarChar(255)

  nicheDescription String  @db.Text
  styleGuide       String? @db.Text

  brandAssets Json @default("{}")

  postingCadence     String? @db.VarChar(255)
  approvalGateConfig Json    @default("{\"gate1Enabled\": true, \"gate2Enabled\": true}")
  priorsScope        String  @default("isolated") @db.VarChar(20)

  // Week 5 Task 4 (C2, KNOWN_ISSUES_AND_BLOCKERS.md "no fair-access policy
  // across channels") — nullable, default null for every existing and
  // newly-created channel: null means "use the platform's pooled
  // AgentQuota.budgetCeilingUsd, split equally across every default-share
  // channel on this (tenantId, platform)"; a set value means "this
  // channel's ceiling is exactly this, regardless of channel count." See
  // studio/src/run-pipeline/budget-gate.ts's computeChannelBudgetCeilings.
  budgetOverrideUsd Decimal? @db.Decimal(10, 2)

  // Sprint 2 Task 1 (D1/D2) — nullable, default null for every existing and
  // newly-created channel: null means "use media/registry.ts's hardcoded
  // DEFAULT_TTS_VOICE fallback"; a set value (one of media/registry.ts's
  // TTS_VOICES keys) is this channel's own default, used whenever a run on
  // it doesn't explicitly override the voice per-brief. See
  // studio/src/run-pipeline/state-machine.ts's runVideoGenerationStage for
  // the full three-step resolution order.
  defaultVoice String? @db.VarChar(50)

  // Sprint 3 Task 2 (K1) — nullable FK to User, deliberately: a channel
  // created before this migration, or one whose owning user was since
  // removed, degrades to "any owner-role user on the tenant may resolve its
  // gates" rather than becoming permanently unapprovable. This migration's
  // own backfill sets every existing Channel row to its tenant's seeded
  // owner — no real, currently-working channel is left null as a side
  // effect of adding this column. See api/routers/runs.ts's gate1/gate2
  // ownership check.
  ownerUserId String? @db.Uuid

  // UI Enhancement 1 (Sprint 3 Task 8, R1) — the privacy status Gate 2
  // approval applies when the approver doesn't choose one explicitly.
  // VARCHAR + CHECK (private|unlisted|public, same set as
  // agents/publishing/types.ts's PrivacyStatusSchema), per this schema's
  // convention. Default 'private' matches every upload's de facto
  // behavior before this column existed.
  defaultPrivacyStatus String @default("private") @db.VarChar(20)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant               Tenant               @relation(fields: [tenantId], references: [id])
  ownerUser            User?                 @relation(fields: [ownerUserId], references: [id])
  pipelineRuns         PipelineRun[]
  reviewLogs           ReviewLog[]
  usageEvents          UsageEvent[]
  performanceSnapshots PerformanceSnapshot[]
  notifications        Notification[]
  agentCredential      AgentCredential?

  // Sprint 4 Task 1: null (every existing channel) means "no profile": resolve
  // from legacy fields and platform defaults. See channel-profile/resolve.ts.
  activeProfileVersionId String?                  @db.Uuid
  activeProfileVersion   ChannelProfileVersion?   @relation("ActiveChannelProfile", fields: [activeProfileVersionId], references: [id])
  profileVersions        ChannelProfileVersion[]  @relation("ChannelProfileVersions")

  @@unique([platform, externalChannelId], map: "idx_channels_external")
  @@index([tenantId, isActive], map: "idx_channels_tenant")
  @@index([ownerUserId], map: "idx_channels_owner")
  @@map("channels")
}

// Sprint 3 Task 5 (M1) — AGENT_FLEET_DESIGN.md §6.2's own original naming.
// week1/SCHEMA.md's own deferral note: "a Week 2+ task once a second
// channel makes env-var-per-channel unworkable — still one channel, so
// still not yet." This is that deferred work, picked up on schedule.
// refreshTokenEncrypted is base64(iv || authTag || ciphertext) — AES-256-GCM
// via Node's built-in crypto, no new dependency (models/credential-crypto.ts).
// encryptionKeyVersion defaults to 1 so a future key rotation can identify
// which key encrypted a given row without forcing every channel to
// re-consent at once.
model AgentCredential {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channelId             String   @unique @db.Uuid
  platform              String   @db.VarChar(20)
  refreshTokenEncrypted String   @db.Text
  encryptionKeyVersion  Int      @default(1)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id])

  @@unique([channelId, platform])
  @@map("agent_credentials")
}

// Sprint 3 Task 3 (K2) — the real in-app notification channel
// MVP_PART2 §1 asked for: "in-app push through the dashboard is probably
// the right default channel, with [a second channel] as one optional
// channel." Every gate that opens produces at least one of these — never a
// gate silently waiting with no visible trace anywhere a user would look.
//
// channelId is nullable, a real deviation from this task's own initial
// sketch: a tenant-wide notification (the daily digest, which spans every
// channel on a tenant, not one) has no single channel to attribute the row
// to. Every gate-related row (kind: 'approval_request', and the reminder
// variant of 'notify') sets a real channelId; only the digest leaves it
// null. See sprint3/reports/task3.md.
model Notification {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String  @db.Uuid
  channelId String? @db.Uuid
  userId    String  @db.Uuid

  // 'notify' | 'approval_request', VARCHAR + CHECK per this schema's own convention.
  kind    String @db.VarChar(20)
  message String @db.Text

  // Set only for kind = 'approval_request' — the same threadKey
  // (PipelineRun id) the in-memory pending-approval map
  // (notifications/pending-approvals.ts) already keys on, so an in-app
  // resolution and any other channel's own resolution attempt resolve the
  // exact same pending gate, never two independent ones.
  threadKey String? @db.VarChar(255)

  // Set once this notification's underlying gate (or reminder) has been
  // acted on — via *any* channel, not necessarily this row's own. A
  // 'notify'-kind row (the digest, a reminder) is never itself "resolved";
  // stays null.
  resolvedAt DateTime?

  createdAt DateTime @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  channel Channel? @relation(fields: [channelId], references: [id])
  user    User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt], map: "idx_notifications_user_time")
  @@index([threadKey], map: "idx_notifications_thread")
  @@map("notifications")
}

model PipelineRun {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String @db.Uuid
  channelId String @db.Uuid

  status       String  @default("pending") @db.VarChar(20)
  currentStage String? @db.VarChar(50)

  briefText    String @db.Text
  intakeParsed Json?

  // Sprint 2 Task 1 (D2) — deliberately a separate column from
  // intakeParsed, not a merge into it: intakeParsed is what parse-brief.ts's
  // LLM call extracted from free-text prose; creationOptions is what the
  // user explicitly picked via structured API fields (never inferred).
  // Shape: { voice?: string, visualSource?: string, audioLayer?: string } —
  // this task only ever sets `voice`; the other two fields exist in the
  // shape now so Sprint 2 Task 2/3 extend one object instead of adding
  // parallel columns. Nullable, no backfill — every existing run is null.
  creationOptions Json?

  // Sprint 4 Task 1: snapshot of the channel's active profile version at run
  // creation; never re-read from the channel later. null = no profile.
  profileVersionId String?                @db.Uuid
  profileVersion   ChannelProfileVersion? @relation(fields: [profileVersionId], references: [id])

  retryCount Int     @default(0)
  lastError  String? @db.Text

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  channel Channel @relation(fields: [channelId], references: [id])

  stages               PipelineStage[]
  reviewLogs           ReviewLog[]
  usageEvents          UsageEvent[]
  performanceSnapshots PerformanceSnapshot[]

  @@index([tenantId, channelId], map: "idx_runs_tenant_channel")
  @@index([status], map: "idx_runs_status")
  @@map("pipeline_runs")
}

model PipelineStage {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pipelineRunId String @db.Uuid
  stageName     String @db.VarChar(50)
  status        String @default("pending") @db.VarChar(20)
  attemptNumber Int    @default(1)

  input  Json?
  output Json?

  startedAt   DateTime?
  completedAt DateTime?
  error       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())

  pipelineRun PipelineRun  @relation(fields: [pipelineRunId], references: [id])
  reviewLogs  ReviewLog[]
  usageEvents UsageEvent[]

  @@unique([pipelineRunId, stageName, attemptNumber])
  @@index([pipelineRunId], map: "idx_stages_run")
  @@map("pipeline_stages")
}

model ReviewLog {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String  @db.Uuid
  channelId     String  @db.Uuid
  pipelineRunId String  @db.Uuid
  stageId       String? @db.Uuid

  agent        String @db.VarChar(100)
  verdict      String @db.VarChar(50)
  rationale    String @db.Text
  editedOutput Json?

  timestamp DateTime @default(now())

  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  channel     Channel        @relation(fields: [channelId], references: [id])
  pipelineRun PipelineRun    @relation(fields: [pipelineRunId], references: [id])
  stage       PipelineStage? @relation(fields: [stageId], references: [id])

  @@index([pipelineRunId], map: "idx_reviewlog_run")
  @@index([channelId, timestamp], map: "idx_reviewlog_channel_time")
  @@map("review_logs")
}

// Week 2 additions — see docs/execution/week2/SCHEMA.md Sections 1-2.

model AgentQuota {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @db.Uuid
  platform String @default("youtube") @db.VarChar(20)

  budgetCeilingUsd Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, platform])
  @@map("agent_quotas")
}

model UsageEvent {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String  @db.Uuid
  channelId     String  @db.Uuid
  pipelineRunId String? @db.Uuid
  stageId       String? @db.Uuid

  agent    String @db.VarChar(100)
  provider String @db.VarChar(50)
  model    String @db.VarChar(100)

  inputTokens          Int?
  outputTokens         Int?
  characterCount       Int?
  audioDurationSeconds Decimal? @db.Decimal(10, 2)
  costUsd              Decimal  @db.Decimal(10, 4)
  metadata             Json?

  createdAt DateTime @default(now())

  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  channel     Channel        @relation(fields: [channelId], references: [id])
  pipelineRun PipelineRun?   @relation(fields: [pipelineRunId], references: [id])
  stage       PipelineStage? @relation(fields: [stageId], references: [id])

  @@index([tenantId, createdAt], map: "idx_usage_tenant_platform_time")
  @@index([pipelineRunId], map: "idx_usage_run")
  @@map("usage_events")
}

// Week 4 addition — see docs/execution/week4/SCHEMA.md Section 1.
model PerformanceSnapshot {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String @db.Uuid
  channelId     String @db.Uuid
  pipelineRunId String @db.Uuid

  youtubeVideoId String @db.VarChar(255)

  views    BigInt @default(0)
  likes    BigInt @default(0)
  comments BigInt @default(0)

  watchTimeMinutes Decimal? @db.Decimal(10, 2)
  retentionPct     Decimal? @db.Decimal(5, 2)
  // Sprint 2 Task 4 (G2) — the real, timestamp-level audience-retention
  // curve, not just the single retentionPct summary number above. Array of
  // { elapsedVideoTimeRatio: number, audienceWatchRatio: number } points,
  // the real dimension/metric pair the YouTube Analytics API's
  // audience-retention report returns. Nullable — every existing row is
  // correctly null (recorded before this field existed), and every new row
  // stays null until G1's yt-analytics.readonly OAuth scope is actually
  // granted (YOUTUBE_STUB=1 or an ungranted scope both leave this null).
  // Nothing reads this yet — Continuous Learning (a later sprint) is what
  // eventually will; "cheap now, expensive to reconstruct later."
  retentionCurve   Json?

  snapshotAt DateTime
  createdAt  DateTime @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  channel     Channel     @relation(fields: [channelId], references: [id])
  pipelineRun PipelineRun @relation(fields: [pipelineRunId], references: [id])

  @@index([youtubeVideoId, snapshotAt], map: "idx_snapshots_video_time")
  @@index([pipelineRunId], map: "idx_snapshots_run")
  @@map("performance_snapshots")
}

// Testing-phase utility, not a real product model — a lightweight bug inbox
// for manual app testing, deliberately outside the Tenant/User model
// entirely: a tester reporting a bug may not be signed in, or the bug may
// be that they can't sign in at all, so this has no auth and no tenancy
// scoping. `status` isn't exposed on the one-field public form at all — it
// exists purely so a later pass through this table (by a human or an
// agent) can mark rows worked through instead of re-reading the same ones
// every time. Plan is to remove this table (or replace it with something
// more sophisticated) once real testing winds down — see api/server.ts's
// /bugs routes and api/bug-report-page.ts for the rest of this feature.
model BugReport {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  description String @db.Text
  status      String @default("open") @db.VarChar(20)

  // Bugs Task 7 (R2) — 'bug' | 'feedback', tester-supplied at submission,
  // required. Defaults every existing (pre-this-migration) row to 'bug',
  // accurate: this table had no other kind of report before now.
  reportType String @default("bug") @db.VarChar(20)
  // Bugs Task 7 (R2) — 'blocker' | 'annoying' | 'minor', tester-supplied,
  // required only when reportType = 'bug' (validated server-side in
  // insertBugReport, not enforced at the DB level — feedback rows are
  // expected to leave this null).
  priority String? @db.VarChar(20)
  // Bugs Task 7 (R3) — 'BE' | 'FE' | 'APP', never tester-facing. null means
  // "not yet triaged." Set only via bugsRouter.updateTriage.
  area String? @db.VarChar(20)

  // Run/screen context — added so a report can be cross-checked against
  // Postgres the same way every other fix in this project has been, instead
  // of relying on the tester's own prose description of where they were.
  // Deliberately no relation/FK to PipelineRun: a bug report should never be
  // blocked by referential integrity (a stale or deleted run must not make
  // the report un-loggable) — a bad/garbage runId is trivially obvious when
  // triaging and not worth guarding against. Derived fresh from the router
  // at tap time (app/components/ReportBugButton.tsx), never from any
  // separately-maintained "current context" state.
  runId         String? @db.Uuid
  screenContext String? @db.VarChar(255)
  // Captured server-side from the request header (api/server.ts's POST
  // /bugs handler), never typed or supplied by the tester.
  userAgent     String? @db.Text

  createdAt DateTime @default(now())

  @@map("bug_reports")
}

// Sprint 4 Task 1: versioned channel configuration. Immutable once written;
// a change is a new row (version = max + 1) and the channel's
// activeProfileVersionId moves to it. `data` is validated against
// channel-profile/schema.ts's ChannelProfileDataSchema at write time.
model ChannelProfileVersion {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channelId       String   @db.Uuid
  version         Int
  data            Json
  createdByUserId String?  @db.Uuid
  createdAt       DateTime @default(now())

  channel           Channel       @relation("ChannelProfileVersions", fields: [channelId], references: [id])
  activeForChannels Channel[]     @relation("ActiveChannelProfile")
  createdByUser     User?         @relation(fields: [createdByUserId], references: [id])
  pipelineRuns      PipelineRun[]

  @@unique([channelId, version])
  @@index([channelId], map: "idx_channel_profile_versions_channel")
  @@map("channel_profile_versions")
}
